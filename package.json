{
  "name": "script-hop",
  "version": "0.5.0",
  "description": "Fuzzy, frecency-ranked picker for package.json scripts. Works with npm, pnpm, yarn, bun and deno.",
  "author": "zanthrash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanthrash/script-hop.git"
  },
  "homepage": "https://github.com/zanthrash/script-hop#readme",
  "bugs": {
    "url": "https://github.com/zanthrash/script-hop/issues"
  },
  "type": "module",
  "bin": {
    "hop": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "dev": "tsdown --config-loader native --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "deno",
    "scripts",
    "task-runner",
    "fuzzy",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@inquirer/search": "^4.3.4",
    "cross-spawn": "^7.0.6",
    "env-paths": "^4.0.0",
    "fzf": "^0.5.2",
    "jsonc-parser": "^3.3.1",
    "package-manager-detector": "^1.9.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
